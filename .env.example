# Which backend answers a turn. Defaults to "local", which needs no network,
# no account and no key - that is what `npm run dev` and the test suite use.
#   local -> src/lib/providers/scriptedProvider.ts
#   http  -> src/lib/providers/httpProvider.ts
VITE_CHAT_PROVIDER=local

# Only read when VITE_CHAT_PROVIDER=http. This must point at YOUR OWN server,
# not at a model vendor. The proxy holds the model credential and authenticates
# the browser session; it exposes POST {base}/chat returning text/event-stream.
#
# There is deliberately no VITE_*_API_KEY here. Vite inlines every VITE_ value
# into the JavaScript it ships, so a key set this way is readable by every
# visitor in devtools. src/config.ts logs a warning if one is found.
VITE_CHAT_API_BASE_URL=

# Milliseconds between streamed chunks in the local provider. Lower it to make
# the scripted answers arrive faster.
VITE_STREAM_CHUNK_DELAY_MS=28

# Attachment limits, enforced in src/lib/attachments.ts.
VITE_MAX_ATTACHMENTS=5
VITE_MAX_ATTACHMENT_BYTES=10485760
